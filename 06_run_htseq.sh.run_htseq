#!/bin/bash
#SBATCH --job-name=htseq-count
#SBATCH --output=htseq-count_%j.out
#SBATCH --error=htseq-count_%j.err
#SBATCH --time=08:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --partition=short

# Load Anaconda
module load anaconda3/2022.05

# Activate your environment
CONDA_ENV="${CONDA_ENV:-trim_galore_env}"
eval "$(conda shell.bash hook)"
conda activate "$CONDA_ENV"

# Define the directory and GTF file
BAM_DIR="${BAM_DIR:-./star_alignment_output}"  
GTF_FILE="${GTF_FILE:-./GCF_014441545.1/genomic.gtf}"       
OUTPUT_DIR="${OUTPUT_DIR:-./output_counts}"       

# Create output directory if it doesn't exist/
mkdir -p "$OUTPUT_DIR"

# Loop over each BAM file ending in _Aligned.sortedByCoord.out.bam
for BAM_FILE in "$BAM_DIR"/*_Aligned.sortedByCoord.out.bam; do
    # Extract the base filename without the directory and extension
    BASENAME=$(basename "$BAM_FILE" _Aligned.sortedByCoord.out.bam)
    
    # Define output file for htseq-count
    OUTPUT_FILE="$OUTPUT_DIR/${BASENAME}_counts.txt"
    
    # Run htseq-count
    htseq-count -f bam -s no -t exon -i gene_id "$BAM_FILE" "$GTF_FILE" > "$OUTPUT_FILE"
done

echo "htseq-count completed for all files"
